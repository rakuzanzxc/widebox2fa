[Unit]
Description=WideBox Telegram 2FA Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=widebox
WorkingDirectory=/opt/widebox2fa
EnvironmentFile=/opt/widebox2fa/.env
ExecStart=/opt/widebox2fa/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8787
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
